<UserControl x:Class="Mozhou.Desktop.BookshelfView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Surface}" Foreground="{StaticResource Ink}"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="CoverButton" TargetType="Button">
   <Setter Property="Padding" Value="4"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Line}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Grid Margin="42,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="27" Height="29" BorderBrush="{StaticResource Accent}" BorderThickness="1" Margin="0,0,13,0">
     <TextBlock Text="舟" FontFamily="{DynamicResource DisplayFont}" Foreground="{StaticResource Accent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock Text="墨舟" FontFamily="{DynamicResource DisplayFont}" FontSize="24" VerticalAlignment="Center"/>
    <TextBlock Text="小说工作台" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="22,3,0,0"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="手稿 · 故事 · 世界" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
   <Border Grid.ColumnSpan="2" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom"/>
  </Grid>
  <Grid Grid.Row="1" Margin="42,34,18,0" MaxWidth="1240">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,24,27">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="我的书架" FontFamily="{DynamicResource DisplayFont}" FontSize="38"/>
     <TextBlock Text="每一个故事，都有自己的篇章。" FontSize="13" Foreground="{StaticResource Muted}" Margin="2,12,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,3">
     <Button Content="打开小说文件夹" Style="{StaticResource Ghost}" Click="OpenExistingClick" Padding="14,10" Margin="0,0,13,0" FontSize="13" ToolTip="将现有小说加入书架"/>
     <Button Style="{StaticResource Primary}" Click="NewClick" Padding="19,11" FontSize="13" AutomationProperties.Name="新建小说">
      <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="M10,3 L10,17 M3,10 L17,10" Stroke="{StaticResource Paper}" Width="13" Height="13" Margin="0,0,9,0"/><TextBlock Text="新建小说"/></StackPanel>
     </Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,24,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="TotalCountLabel" Text="共 0 本" FontSize="12" Foreground="{StaticResource Ink}"/>
     <TextBlock Text="按最近打开排序" FontSize="12" Foreground="{StaticResource Muted}" Margin="20,0,0,0"/>
     <TextBlock x:Name="ResultsLabel" Foreground="{StaticResource Accent}" FontSize="12" Margin="20,0,0,0"/>
    </StackPanel>
    <Border Grid.Column="1" Width="278" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
     <Grid>
      <Path Style="{StaticResource Icon}" Data="M8,2 A6,6 0 1 1 7.99,2 M12,12 L18,18" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0"/>
      <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="27,9,31,9" FontSize="13" TextChanged="SearchChanged" AutomationProperties.Name="搜索小说书名或简介"/>
      <TextBlock Text="搜索书名或简介" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="27,0,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Button x:Name="ClearSearchButton" Content="×" Style="{StaticResource Ghost}" Click="ClearSearchClick" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Padding="4" FontSize="17" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" Visibility="Collapsed"/>
     </Grid>
    </Border>
   </Grid>
   <Border x:Name="NoticePanel" Grid.Row="2" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Padding="13,10" Margin="0,0,24,17" Visibility="Collapsed">
    <TextBlock x:Name="NoticeText" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap"/>
   </Border>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="BooksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,12">
     <ItemsControl x:Name="BooksList" SizeChanged="BooksSizeChanged" HorizontalAlignment="Stretch">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="390"/></Style></ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,4,28,34">
        <Grid.RowDefinitions><RowDefinition Height="267"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
         <TextBlock Text="{Binding IndexLabel}" FontFamily="Georgia" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0" VerticalAlignment="Top"/>
         <TextBlock Text="上次打开" FontSize="11" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" Margin="0,8,0,0" VerticalAlignment="Top" Visibility="{Binding RecentVisibility}"/>
         <Button Style="{StaticResource CoverButton}" Click="OpenBookClick" Width="190" Height="255" HorizontalAlignment="Center" VerticalAlignment="Top" ToolTip="{Binding OpenTooltip}" AutomationProperties.Name="{Binding CoverOpenName}">
          <Grid>
           <Border Background="#DDD4C6" Margin="6,4,0,0"/>
           <Border BorderBrush="#BDB3A4" BorderThickness="0,0,1,1" Margin="5,3,1,1"/>
           <Border Background="{Binding CoverBrush}" Margin="0,0,4,4" BorderBrush="#18000000" BorderThickness="0,0,1,0">
            <Grid ClipToBounds="True">
             <Border Width="9" HorizontalAlignment="Left" Background="#15000000"/>
             <Border Width="1" HorizontalAlignment="Left" Background="#28FFFFFF" Margin="10,0,0,0"/>
             <Ellipse Width="124" Height="124" Stroke="{Binding CoverInkBrush}" StrokeThickness="0.8" Opacity="0.34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-22,19"/>
             <Ellipse Width="91" Height="91" Stroke="{Binding CoverInkBrush}" StrokeThickness="0.8" Opacity="0.28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,35"/>
             <Path Data="M0,20 L85,20 M0,27 L104,27 M0,34 L121,34" Stroke="{Binding CoverInkBrush}" StrokeThickness="0.7" Opacity="0.28" Width="121" Height="34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,51"/>
             <Border Height="1" Background="{Binding CoverInkBrush}" Opacity="0.45" Margin="24,22,18,0" VerticalAlignment="Top"/>
             <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" Foreground="{Binding CoverInkBrush}" FontSize="{Binding CoverTitleFontSize}" LineHeight="{Binding CoverTitleLineHeight}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="138" VerticalAlignment="Top" Margin="24,37,18,0" ToolTip="{Binding Title}"/>
             <TextBlock Text="创 作 手 稿" Foreground="{Binding CoverInkBrush}" FontSize="11" Margin="25,0,0,23" VerticalAlignment="Bottom"/>
             <Border BorderBrush="{Binding CoverInkBrush}" BorderThickness="0.8" Width="21" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,17,18"><TextBlock Text="舟" FontFamily="{DynamicResource DisplayFont}" FontSize="13" Foreground="{Binding CoverInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </Grid>
           </Border>
          </Grid>
         </Button>
        </Grid>
        <StackPanel Grid.Row="1">
         <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="23" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" LineHeight="30"/>
         <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="44" LineHeight="22" Margin="0,9,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0" Padding="8,7" Margin="0,11,0,0" Visibility="{Binding ProblemVisibility}"><TextBlock Text="{Binding Problem}" Foreground="{StaticResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Problem}"/></Border>
        <StackPanel Grid.Row="3">
         <Grid Margin="0,15,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Statistics}" Foreground="{StaticResource Muted}" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="{Binding UpdatedLabel}" ToolTip="{Binding UpdatedTooltip}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,1,0,0"/>
         </Grid>
         <Border Height="1" Background="{StaticResource Line}"/>
         <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="{Binding OpenLabel}" Click="OpenBookClick" Style="{StaticResource Ghost}" Foreground="{StaticResource Ink}" HorizontalAlignment="Left" FontSize="13" Padding="0,8" ToolTip="{Binding OpenTooltip}"/>
          <Button Grid.Column="1" Content="···" Style="{StaticResource Ghost}" Click="BookMenuClick" FontSize="20" Padding="8,0" MinHeight="34" ToolTip="管理这本小说" AutomationProperties.Name="管理小说">
           <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="重新定位" Click="LocateBookClick" ToolTip="选择这本小说移动后的文件夹"/>
            <MenuItem Header="移出书架" Click="ForgetBookClick" ToolTip="仅移除书架记录，不会删除小说文件"/>
           </ContextMenu></Button.ContextMenu>
          </Button>
         </Grid>
        </StackPanel>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Grid x:Name="EmptyPanel" Margin="0,0,24,20" Visibility="Collapsed">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
      <Grid Width="108" Height="123" Margin="0,0,0,25">
       <Border Background="#E3D7C2" Width="81" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid><Border Width="7" HorizontalAlignment="Left" Background="#CBBCA3"/><Border BorderBrush="#A99B83" BorderThickness="0,1,0,1" Margin="20,20,14,29"/><TextBlock Text="序" FontFamily="{DynamicResource DisplayFont}" Foreground="#6B5E49" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
       <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom"/>
      </Grid>
      <TextBlock Text="从第一本开始" FontFamily="{DynamicResource DisplayFont}" FontSize="28" HorizontalAlignment="Center"/>
      <TextBlock Text="写下一个名字，让故事有一个开始。" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,15,0,0" HorizontalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
       <Button Content="新建第一本小说" Style="{StaticResource Primary}" Click="NewClick" FontSize="13" Padding="18,10"/>
       <Button Content="打开已有小说" Style="{StaticResource Ghost}" Click="OpenExistingClick" FontSize="13" Margin="15,0,0,0"/>
      </StackPanel>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="NoResultsPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,60">
     <TextBlock Text="未找到匹配的小说" FontFamily="{DynamicResource DisplayFont}" FontSize="27" HorizontalAlignment="Center"/>
     <TextBlock Text="试试其他书名，或简介里的关键词。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,15,0,0" HorizontalAlignment="Center"/>
     <Button Content="查看全部小说" Click="ClearSearchClick" Style="{StaticResource Ghost}" Foreground="{StaticResource Accent}" FontSize="13" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="42,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="2" Height="1" Background="{StaticResource Line}" VerticalAlignment="Top"/>
   <TextBlock Text="手稿保存在你选择的本地文件夹。" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="1" Text="墨舟 · 创作手稿" FontFamily="{DynamicResource DisplayFont}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</UserControl>