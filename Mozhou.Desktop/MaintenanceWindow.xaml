<Window x:Class="Mozhou.Desktop.MaintenanceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="墨舟 · 版本与更新" Width="480" SizeToContent="Height" ResizeMode="NoResize"
 Background="{StaticResource Paper}" FontFamily="{StaticResource BodyFont}"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="28,24,28,26">
  <TextBlock Text="版本与更新" FontFamily="{StaticResource DisplayFont}" FontSize="24"/>
  <TextBlock x:Name="CurrentLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
  <Border Height="1" Background="{StaticResource Line}"/>
  <TextBlock x:Name="UpdateStatus" Text="从墨舟的 GitHub 发布页检查最新正式版。" TextWrapping="Wrap"
             AutomationProperties.LiveSetting="Polite" LineHeight="21" Margin="0,16,0,11"/>
  <WrapPanel>
   <Button x:Name="CheckButton" Content="检查更新" Click="CheckClick" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
   <Button x:Name="DownloadButton" Click="DownloadClick" Visibility="Collapsed"/>
  </WrapPanel>
  <StackPanel x:Name="UninstallPanel" Visibility="Collapsed" Margin="0,22,0,0">
   <Border Height="1" Background="{StaticResource Line}"/>
   <TextBlock Text="卸载墨舟" FontSize="15" Margin="0,16,0,6"/>
   <TextBlock Text="在 Windows 应用列表中找到「墨舟」。开始卸载前，请先保存并关闭墨舟。小说文档、书架和设置会保留。"
              Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
   <Button Content="打开 Windows 应用列表" Click="UninstallClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
