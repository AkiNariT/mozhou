<UserControl x:Class="Mozhou.Desktop.ReferenceImagesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MaxHeight="180" UseLayoutRounding="True">
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Paper}">
  <Grid Margin="0,4,0,0">
   <Expander x:Name="ImagesExpander" IsExpanded="False" Expanded="ImagesExpanded" Collapsed="ImagesCollapsed">
    <Expander.Header><TextBlock x:Name="HeaderText" Text="参考图 · 0" FontSize="12"/></Expander.Header>
    <ScrollViewer Height="130" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ItemsControl x:Name="ImageList" VerticalAlignment="Top">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Width="148" Margin="0,0,10,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}" CornerRadius="2">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="25"/></Grid.RowDefinitions>
          <Button Click="PreviewClick" Tag="{Binding Image}" Style="{StaticResource Ghost}" Padding="5" MinHeight="0" IsEnabled="{Binding CanPreview}" ToolTip="{Binding PreviewHint}" AutomationProperties.Name="{Binding PreviewHint}">
           <Grid Width="136" Height="68">
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding Placeholder}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="124"/>
           </Grid>
          </Button>
          <Grid Grid.Row="1" Margin="7,0,4,1">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,3,0"/>
           <Button Grid.Column="1" Content="移除" Tag="{Binding Image}" Click="RemoveClick" Style="{StaticResource Ghost}" MinHeight="22" Padding="3,0" FontSize="10" ToolTip="从当前条目移除参考图" AutomationProperties.Name="移除参考图"/>
          </Grid>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Expander>
   <Button x:Name="AddButton" Content="＋ 添加图片" Click="AddClick" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="28" Padding="6,3" FontSize="12" Foreground="{StaticResource Accent}" AutomationProperties.Name="添加参考图片"/>
  </Grid>
 </Border>
</UserControl>
